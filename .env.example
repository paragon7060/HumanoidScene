# Copy to .env only for your own shell tooling; launchers read exported variables.
export ISAACLAB_PYTHON=/absolute/path/to/env_isaaclab_232/bin/python
export ISAACLAB_DIR=/absolute/path/to/IsaacLab-v2.3.2
export LEROBOT_PYTHON=/absolute/path/to/lerobot-v3-environment/bin/python
export XR_RUNTIME_JSON=/absolute/path/to/openxr_cloudxr.json
export CLOUDXR_NPM_TGZ=/absolute/path/to/nvidia-cloudxr-6.2.0.tgz
# Standalone Runtime / HTTPS client server (see docs/QUEST_RUNTIME_SERVICE.md):
# export CLOUDXR_RUNTIME_DIR=/absolute/path/to/extracted-cloudxr-runtime
# export CLOUDXR_HOST=192.168.0.10
# export CLOUDXR_CERTIFICATE=/absolute/path/to/localhost.crt
# export CLOUDXR_KEY=/absolute/path/to/localhost.key
# export CLOUDXR_JS_SAMPLES_DIR=/absolute/path/to/cloudxr-js-samples

# Optional deployment overrides:
# export KUAVO_CONFIG_DIR=/absolute/path/to/writable/configs
# export KUAVO_WORKCELL_LAYOUT=/absolute/path/to/workcell_layout.json
# export KUAVO_RACK_BOX_POSES=/absolute/path/to/rack_box_poses.json

# Temporary diagnostics only. Normal runs should leave this unset so a stale
# Isaac Sim/Isaac Lab environment fails fast.
# export KUAVO_ALLOW_UNSUPPORTED_RUNTIME=1
