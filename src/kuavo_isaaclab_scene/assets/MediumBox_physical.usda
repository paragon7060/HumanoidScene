#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Z"
    customLayerData = {
        string sourceTemplate = "MediumBox.usd"
        string dimensions = "W=0.320m D=0.220m bodyH=0.185m flap=0.110m"
    }
)

def Xform "Root" (
    prepend references = @./MediumBox.usd@</Root>
)
{
    over Xform "MediumBox"
    {
        float3 xformOp:scale = (0.316831683, 0.217821782, 0.185)

        over Cube "flap_front"
        {
            double3 xformOp:scale = (0.98, 0.01, 0.594594595)
            double3 xformOp:translate = (0, 0.5, 1.302297297)

            over PhysicsRevoluteJoint "joint_front"
            {
                point3f physics:localPos0 = (0, 0.5, 1.005)
                point3f physics:localPos1 = (0, 0, -0.5)
            }
        }
        over Cube "flap_back"
        {
            double3 xformOp:scale = (0.98, 0.01, 0.594594595)
            double3 xformOp:translate = (0, -0.5, 1.302297297)

            over PhysicsRevoluteJoint "joint_back"
            {
                point3f physics:localPos0 = (0, -0.5, 1.005)
                point3f physics:localPos1 = (0, 0, -0.5)
            }
        }
        over Cube "flap_right"
        {
            double3 xformOp:scale = (0.01, 0.98, 0.594594595)
            double3 xformOp:translate = (0.5, 0, 1.302297297)

            over PhysicsRevoluteJoint "joint_right"
            {
                point3f physics:localPos0 = (0.5, 0, 1.005)
                point3f physics:localPos1 = (0, 0, -0.5)
            }
        }
        over Cube "flap_left"
        {
            double3 xformOp:scale = (0.01, 0.98, 0.594594595)
            double3 xformOp:translate = (-0.5, 0, 1.302297297)

            over PhysicsRevoluteJoint "joint_left"
            {
                point3f physics:localPos0 = (-0.5, 0, 1.005)
                point3f physics:localPos1 = (0, 0, -0.5)
            }
        }
    }
}
