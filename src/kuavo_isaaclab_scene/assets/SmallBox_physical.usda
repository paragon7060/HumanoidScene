#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Z"
    customLayerData = {
        string sourceTemplate = "SmallBox.usd"
        string dimensions = "W=0.266m D=0.185m bodyH=0.130m flap=0.100m"
    }
)

def Xform "Root" (
    prepend references = @./SmallBox.usd@</Root>
)
{
    over Xform "SmallBox"
    {
        float3 xformOp:scale = (0.263366337, 0.183168317, 0.13)

        over Cube "flap_front"
        {
            double3 xformOp:scale = (0.98, 0.01, 0.769230769)
            double3 xformOp:translate = (0, 0.5, 1.389615385)

            over PhysicsRevoluteJoint "joint_front"
            {
                point3f physics:localPos0 = (0, 0.5, 1.005)
                point3f physics:localPos1 = (0, 0, -0.5)
            }
        }
        over Cube "flap_back"
        {
            double3 xformOp:scale = (0.98, 0.01, 0.769230769)
            double3 xformOp:translate = (0, -0.5, 1.389615385)

            over PhysicsRevoluteJoint "joint_back"
            {
                point3f physics:localPos0 = (0, -0.5, 1.005)
                point3f physics:localPos1 = (0, 0, -0.5)
            }
        }
        over Cube "flap_right"
        {
            double3 xformOp:scale = (0.01, 0.98, 0.769230769)
            double3 xformOp:translate = (0.5, 0, 1.389615385)

            over PhysicsRevoluteJoint "joint_right"
            {
                point3f physics:localPos0 = (0.5, 0, 1.005)
                point3f physics:localPos1 = (0, 0, -0.5)
            }
        }
        over Cube "flap_left"
        {
            double3 xformOp:scale = (0.01, 0.98, 0.769230769)
            double3 xformOp:translate = (-0.5, 0, 1.389615385)

            over PhysicsRevoluteJoint "joint_left"
            {
                point3f physics:localPos0 = (-0.5, 0, 1.005)
                point3f physics:localPos1 = (0, 0, -0.5)
            }
        }
    }
}
