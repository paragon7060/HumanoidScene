# Local, one-off validation scripts; reusable CI tests stay tracked.
tests/local/

# Real-robot calibration source code is tracked, but robot measurements and
# generated analyses stay local. These may be large and can contain details
# specific to one physical robot and test session.
real_robot_calibration/**/data/
real_robot_calibration/**/reports/
real_robot_calibration/**/measured_parameters.json
real_robot_calibration/**/*.md
real_robot_control/logs/
real_robot_control/trajectories/
